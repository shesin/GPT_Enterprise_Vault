{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartbeads-hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web:smartbeads"
      ],
      "port": 5173
    },
    {
      "name": "smartbeads-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 3001,
      "env": {
        "PORT": "3001"
      }
    }
  ]
}