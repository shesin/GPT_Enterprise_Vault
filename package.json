{
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run typecheck",
    "pretest:jest": "npm run typecheck",
    "pretest:jest:fast": "npm run typecheck",
    "test": "node PROJECTS/SmartBeads/scripts/run-jest-batched.mjs && node PROJECTS/SmartBeads/scripts/m2-2step-npm-gate.mjs",
    "test:jest": "node PROJECTS/SmartBeads/scripts/run-jest-batched.mjs",
    "test:jest:fast": "node PROJECTS/SmartBeads/scripts/run-jest-batched.mjs --skip-slow",
    "test:smartbeads": "node PROJECTS/SmartBeads/scripts/run-jest-batched.mjs",
    "play:board4": "npx tsx PROJECTS/SmartBeads/src/playtest/HumanVsAiRunner.ts",
    "sim:board4": "npx tsx PROJECTS/SmartBeads/src/simulation/SelfPlayRunner.ts",
    "web:board4": "vite",
    "web:smartbeads": "vite",
    "build:smartbeads": "vite build",
    "preview:smartbeads": "vite preview",
    "lint": "eslint \"PROJECTS/SmartBeads/{src,server}/**/*.ts\"",
    "lint:fix": "eslint \"PROJECTS/SmartBeads/{src,server}/**/*.ts\" --fix",
    "format": "prettier --write \"PROJECTS/SmartBeads/{src,server}/**/*.ts\"",
    "format:check": "prettier --check \"PROJECTS/SmartBeads/{src,server}/**/*.ts\"",
    "server": "tsx PROJECTS/SmartBeads/server/main.ts",
    "build:server": "esbuild PROJECTS/SmartBeads/server/main.ts --bundle --platform=node --target=node20 --outfile=server-dist/main.js --external:ws",
    "start": "node server-dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "msedge-tts": "^2.0.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "nodemailer": "^10.0.13",
    "ws": "^8.22.0"
  }
}
